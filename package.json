{
    "name": "maroonedsoftware.com",
    "private": true,
    "license": "MIT",
    "description": "The public website at maroonedsoftware.com: who Marooned Software is and what it makes.",
    "packageManager": "pnpm@11.23.0",
    "scripts": {
        "start": "docusaurus start --port 8083",
        "build": "tsc --noEmit && docusaurus build --out-dir dist",
        "serve": "docusaurus serve --dir dist --port 8083",
        "clear": "docusaurus clear",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/faster": "^3.10.2",
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-classic": "^3.10.2",
        "@docusaurus/tsconfig": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/chakra-petch": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@mdx-js/react": "^3.1.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "prettier": "^3.9.10",
        "prism-react-renderer": "^2.4.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    }
}
